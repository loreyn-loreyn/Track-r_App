<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Track'r"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Trackr">

        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.Trackr.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".auth.LoginActivity" android:exported="false" />
        <activity android:name=".auth.RegisterActivity" android:exported="false" />
        <activity android:name=".auth.ForgotPasswordActivity" android:exported="false" />

        <activity android:name=".main.MainActivity" android:exported="false" />

        <!-- ADD THESE ACTIVITIES -->
        <activity android:name=".main.SettingsActivity"
            android:exported="false"
            android:parentActivityName=".main.MainActivity"/>
        <activity android:name=".main.AccountActivity"
            android:exported="false"
            android:parentActivityName=".main.SettingsActivity"/>
        <activity android:name=".main.NotificationSettingsActivity"
            android:exported="false"
            android:parentActivityName=".main.SettingsActivity"/>
        <activity android:name=".main.HelpActivity"
            android:exported="false"
            android:parentActivityName=".main.SettingsActivity"/>
        <activity android:name=".main.AboutActivity"
            android:exported="false"
            android:parentActivityName=".main.SettingsActivity"/>
        <activity android:name=".main.PrivacyActivity"
            android:exported="false"
            android:parentActivityName=".main.SettingsActivity"/>
        <activity android:name=".main.SearchActivity"
            android:exported="false"
            android:parentActivityName=".main.MainActivity"/>
    </application>
</manifest>